<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
<xs:element name="job_config">
  <xs:complexType>
    <xs:sequence>
      <xs:element name="input">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="audio" type="audio.input.type" minOccurs="0"/>
            <xs:element name="video" type="video.input.type" minOccurs="0"/>
          </xs:sequence>
          </xs:complexType>
      </xs:element>
      <xs:element name="filter" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="audio" type="audio.filter.type" minOccurs="0"/>
            <xs:element name="video" type="video.filter.type" minOccurs="0"/>
          </xs:sequence>
          </xs:complexType>
      </xs:element>
      <xs:element name="output" type="output.type" maxOccurs="16"/>
      <xs:element name="misc" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="temp_dir" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="clean_temp" type="xs:boolean" default="true" minOccurs="0"/>
                  <xs:element name="path" type="xs:string" minOccurs="0"/>
                </xs:sequence>
                </xs:complexType>
            </xs:element>
          </xs:sequence>
          </xs:complexType>
      </xs:element>
    </xs:sequence>
    </xs:complexType>
</xs:element>
<xs:simpleType name="intlist.type">
  <xs:list itemType="xs:integer"/>
</xs:simpleType>
<xs:simpleType name="stringlist.type">
  <xs:list itemType="xs:string"/>
</xs:simpleType>
<xs:complexType name="audio.input.type">
  <xs:sequence>
      <xs:choice maxOccurs="unbounded" minOccurs="1">
        <xs:element name="ac4" type="ac4.audio.input.type"/>
        <xs:element name="wav" type="wav.audio.input.type"/>
        <xs:element name="wav_list" type="wav_list.audio.input.type"/>
        <xs:element name="pcm_s16le" type="pcm_s16le.audio.input.type"/>
        <xs:element name="pcm_s24le" type="pcm_s24le.audio.input.type"/>
        <xs:element name="pcm_f32le" type="pcm_f32le.audio.input.type"/>
        <xs:element name="adm" type="adm.audio.input.type"/>
        <xs:element name="damf" type="damf.audio.input.type"/>
        <xs:element name="wav_s337m" type="wav_s337m.audio.input.type"/>
        <xs:element name="ac3" type="ac3.audio.input.type"/>
        <xs:element name="ec3" type="ec3.audio.input.type"/>
        <xs:element name="dde" type="dde.audio.input.type"/>
        <xs:element name="generic" type="generic.audio.input.type"/>
        <xs:element name="atmos_mezz" type="atmos_mezz.audio.input.type"/>
        <xs:element name="mxf_iab" type="mxf_iab.audio.input.type"/>
        <xs:element name="mp4" type="mp4.audio.input.type"/>
        <xs:element name="manifest" type="manifest.audio.input.type"/>
        <xs:element name="ts" type="ts.audio.input.type"/>
      </xs:choice>
  </xs:sequence>
</xs:complexType>
<xs:complexType name="ac4.audio.input.type">
  <xs:annotation>
    <xs:documentation>
      AC-4 bitstream file.
      Can be set using command-line option '--input-audio AC-4_FILE',
      e.g. '--input-audio /path/to/storage/file_name.ac4'.
    </xs:documentation>
  </xs:annotation>
  <xs:sequence>
      <xs:element name="file_name" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional only if specified via command-line option '--input-audio'.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="storage" type="storage.type"/>
  </xs:sequence>
  <xs:attribute name="version" type="xs:string" fixed="1">
    <xs:annotation>
      <xs:documentation>
        Stage schema version that xml is compatible with.
        Current schema version is provided as "fixed" attribute.
        Version 1 is assumed if property not provided.
      </xs:documentation>
    </xs:annotation>
  </xs:attribute>
</xs:complexType>
<xs:complexType name="wav.audio.input.type">
  <xs:annotation>
    <xs:documentation>
      WAVE file containing interleaved audio.
      Can be set using command-line option '--input-audio WAV_FILE',
      e.g. '--input-audio /path/to/storage/file_name.wav'.
    </xs:documentation>
  </xs:annotation>
  <xs:sequence>
      <xs:element name="file_name" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional only if specified via command-line option '--input-audio'.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="timecode_frame_rate" default="not_indicated" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Frame rate associated with ffoa timecode.
          </xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="not_indicated"/>
            <xs:enumeration value="23.976"/>
            <xs:enumeration value="24"/>
            <xs:enumeration value="25"/>
            <xs:enumeration value="29.97"/>
            <xs:enumeration value="30"/>
            <xs:enumeration value="48"/>
            <xs:enumeration value="50"/>
            <xs:enumeration value="59.94"/>
            <xs:enumeration value="60"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="offset" type="xs:string" default="auto" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Timecode (HH:MM:SS:FF or HH:MM:SS.xx) indicating offset of input file.
            'auto' will set this value based on the input file.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ffoa" type="xs:string" default="auto" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Timecode (HH:MM:SS:FF or HH:MM:SS.xx) indicating ffoa of input file.
            'auto' will set this value based on the input file.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="storage" type="storage.type"/>
  </xs:sequence>
  <xs:attribute name="version" type="xs:string" fixed="1">
    <xs:annotation>
      <xs:documentation>
        Stage schema version that xml is compatible with.
        Current schema version is provided as "fixed" attribute.
        Version 1 is assumed if property not provided.
