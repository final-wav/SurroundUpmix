                  <xs:enumeration value="24"/>
                  <xs:enumeration value="25"/>
                  <xs:enumeration value="29.97"/>
                  <xs:enumeration value="30"/>
                  <xs:enumeration value="50"/>
                  <xs:enumeration value="59.94"/>
                  <xs:enumeration value="60"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
          </xs:complexType>
      </xs:element>
      <xs:element name="custom_dialnorm" default="0" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Sets a specified dialnorm value, disregarding measured loudness.
