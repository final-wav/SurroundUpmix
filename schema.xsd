<xs:complexType name="wav_list.audio.input.type">
  <xs:annotation>
    <xs:documentation>
      List of mono WAV files assigned to specific audio channel.
      Can be set using command-line option '--input-audio WAV_CHANNEL_L,WAV_CHANNEL_R,WAV_CHANNEL_C,WAV_CHANNEL_LFE,WAV_CHANNEL_LS,WAV_CHANNEL_RS,WAV_CHANNEL_LRS,WAV_CHANNEL_RRS',
      e.g. (for 2.0 channel configuration) '--input-audio /path/to/storage/channel_L.wav,/path/to/storage/channel_R.wav'.
    </xs:documentation>
  </xs:annotation>
  <xs:sequence>
      <xs:element name="file_name_L" type="xs:string" minOccurs="0"/>
      <xs:element name="file_name_R" type="xs:string" minOccurs="0"/>
      <xs:element name="file_name_C" type="xs:string" minOccurs="0"/>
      <xs:element name="file_name_LFE" type="xs:string" minOccurs="0"/>
      <xs:element name="file_name_LS" type="xs:string" minOccurs="0"/>
      <xs:element name="file_name_RS" type="xs:string" minOccurs="0"/>
      <xs:element name="file_name_LRS" type="xs:string" minOccurs="0"/>
      <xs:element name="file_name_RRS" type="xs:string" minOccurs="0"/>
